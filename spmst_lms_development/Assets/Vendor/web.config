<?xml version="1.0" encoding="utf-8"?>
<!-- Vendor libraries live in version-numbered folders, so their files never change:
     let browsers keep them for 30 days (no revalidation round trips on every page). -->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00"/>
    </staticContent>
  </system.webServer>
</configuration>
