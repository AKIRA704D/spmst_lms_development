<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="admin.Master.cs" Inherits="spmst_lms_development.Users.MasterPage.admin" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Admin Dashboard | SPAMAST Library</title>
    
    <!-- You can add your CSS links here -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true"></asp:ScriptManager>

        <div class="admin-layout" style="display: flex; min-height: 100vh;">
            <!-- SIDEBAR -->
            <aside class="admin-sidebar" style="width: 260px; background-color: #0b3d2c; color: #fff; padding: 20px;">
                
                <!-- Header / Avatar -->
                <div class="sidebar-header mb-4">
                    <div class="user-profile-avatar">
                        <%= RenderAvatar("header") %>
                    </div>
                </div>

                <!-- NAVIGATION MENU -->
                <nav class="sidebar-nav">
                    
                    <!-- GROUP: CORE OPERATIONS -->
                    <div id="navGroupCoreOps" runat="server" class="nav-group">
                        <h6 class="nav-group-title" style="color: #d4a017; text-transform: uppercase; margin-top: 15px; margin-bottom: 10px; font-size: 0.8rem;">Core Operations</h6>
                        
                        <div id="subGroupDashboards" runat="server" class="nav-subgroup">
                            <asp:HyperLink ID="lnkAdminDashboard" runat="server" NavigateUrl="~/Users/Admin/Dashboard.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-gauge me-2"></i> Admin Dashboard</asp:HyperLink>
                            <asp:HyperLink ID="lnkPatronDashboard" runat="server" NavigateUrl="~/Users/Patron/Dashboard.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-user me-2"></i> Patron Dashboard</asp:HyperLink>
                            <asp:HyperLink ID="lnkMgtDashboard" runat="server" NavigateUrl="~/Users/Management/Dashboard.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-chart-line me-2"></i> Mgt Dashboard</asp:HyperLink>
                            <asp:HyperLink ID="lnkCirDashboard" runat="server" NavigateUrl="~/Users/Circulation/Dashboard.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-arrows-rotate me-2"></i> Circulation Dashboard</asp:HyperLink>
                        </div>

                        <div id="subGroupCirculation" runat="server" class="nav-subgroup">
                            <asp:HyperLink ID="lnkBookBorrow" runat="server" NavigateUrl="~/Users/Circulation/Borrow.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-book me-2"></i> Book Borrow</asp:HyperLink>
                            <asp:HyperLink ID="lnkToPickUp" runat="server" NavigateUrl="~/Users/Circulation/PickUp.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-box me-2"></i> To Pick Up</asp:HyperLink>
                            <asp:HyperLink ID="lnkReservations" runat="server" NavigateUrl="~/Users/Circulation/Reservations.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-calendar-check me-2"></i> Reservations</asp:HyperLink>
                            <asp:HyperLink ID="lnkHistory" runat="server" NavigateUrl="~/Users/Circulation/History.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-clock-rotate-left me-2"></i> History</asp:HyperLink>
                            <asp:HyperLink ID="lnkPenalties" runat="server" NavigateUrl="~/Users/Circulation/Penalties.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-money-bill me-2"></i> Penalties</asp:HyperLink>
                            <asp:HyperLink ID="lnkAttendance" runat="server" NavigateUrl="~/Users/Circulation/Attendance.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-clipboard-user me-2"></i> Attendance</asp:HyperLink>
                        </div>

                        <div id="subGroupCatalog" runat="server" class="nav-subgroup">
                            <asp:HyperLink ID="lnkCatalog" runat="server" NavigateUrl="~/Users/Catalog/Index.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-book-open me-2"></i> Catalog</asp:HyperLink>
                        </div>
                    </div>

                    <!-- GROUP: MANAGEMENT -->
                    <div id="navGroupManagement" runat="server" class="nav-group">
                        <h6 class="nav-group-title" style="color: #d4a017; text-transform: uppercase; margin-top: 15px; margin-bottom: 10px; font-size: 0.8rem;">Management</h6>
                        
                        <div id="subGroupLibrary" runat="server" class="nav-subgroup">
                            <asp:HyperLink ID="lnkInventory" runat="server" NavigateUrl="~/Users/Library/Inventory.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-boxes-stacked me-2"></i> Inventory</asp:HyperLink>
                            <asp:HyperLink ID="lnkLibrarySettings" runat="server" NavigateUrl="~/Users/Admin/Settings/LibrarySettings.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-gear me-2"></i> Library Settings</asp:HyperLink>
                            <asp:HyperLink ID="lnkBookImports" runat="server" NavigateUrl="~/Users/Library/BookImports.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-file-import me-2"></i> Book Imports</asp:HyperLink>
                        </div>

                        <div id="subGroupUsers" runat="server" class="nav-subgroup">
                            <asp:HyperLink ID="lnkAccounts" runat="server" NavigateUrl="~/Users/Management/Accounts.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-users me-2"></i> Accounts</asp:HyperLink>
                            <asp:HyperLink ID="lnkUserImports" runat="server" NavigateUrl="~/Users/Management/UserImports.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-user-plus me-2"></i> User Imports</asp:HyperLink>
                            <asp:HyperLink ID="lnkProfile" runat="server" NavigateUrl="~/Users/Profile.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-id-badge me-2"></i> Profile</asp:HyperLink>
                        </div>

                        <div id="subGroupTransactions" runat="server" class="nav-subgroup">
                            <asp:HyperLink ID="lnkTransactionImports" runat="server" NavigateUrl="~/Users/Management/TransactionImports.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-money-check me-2"></i> Transaction Imports</asp:HyperLink>
                        </div>

                        <div id="subGroupNotifications" runat="server" class="nav-subgroup">
                            <asp:HyperLink ID="lnkNotifications" runat="server" NavigateUrl="~/Users/Notifications.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-bell me-2"></i> Notifications</asp:HyperLink>
                        </div>
                    </div>

                    <!-- GROUP: SYSTEM REGISTRY -->
                    <div id="navGroupRegistry" runat="server" class="nav-group">
                        <h6 class="nav-group-title" style="color: #d4a017; text-transform: uppercase; margin-top: 15px; margin-bottom: 10px; font-size: 0.8rem;">System Registry</h6>
                        
                        <div id="subGroupFeedback" runat="server" class="nav-subgroup">
                            <asp:HyperLink ID="lnkFeedbackRequest" runat="server" NavigateUrl="~/Users/Feedback/Request.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-comment-dots me-2"></i> Feedback Request</asp:HyperLink>
                            <asp:HyperLink ID="lnkFeedback" runat="server" NavigateUrl="~/Users/Feedback/Index.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-comments me-2"></i> Feedback</asp:HyperLink>
                        </div>

                        <div id="subGroupReports" runat="server" class="nav-subgroup">
                            <asp:HyperLink ID="lnkReports" runat="server" NavigateUrl="~/Users/Reports/Index.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-file-lines me-2"></i> Reports</asp:HyperLink>
                            <asp:HyperLink ID="lnkGenerateReports" runat="server" NavigateUrl="~/Users/Reports/Generate.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-file-export me-2"></i> Generate Reports</asp:HyperLink>
                        </div>

                        <div id="subGroupSystem" runat="server" class="nav-subgroup">
                            <asp:HyperLink ID="lnkSystemLogs" runat="server" NavigateUrl="~/Users/System/Logs.aspx" CssClass="nav-link text-white d-block py-1"><i class="fa-solid fa-terminal me-2"></i> System Logs</asp:HyperLink>
                        </div>
                    </div>

                </nav>
            </aside>

            <!-- MAIN CONTENT AREA -->
            <div class="admin-content" style="flex: 1; padding: 30px; background-color: #f8faf7;">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>
    </form>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>