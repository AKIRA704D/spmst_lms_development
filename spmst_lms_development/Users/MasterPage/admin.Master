                        <button type="button" class="nav-submenu-toggle" aria-expanded="false">
                            <i class="fa-solid fa-book-bookmark"></i>
                            <span>Library</span>
                            <i class="fa-solid fa-chevron-down nav-submenu-chevron"></i>
                        </button>
                        <div class="nav-submenu-list">
                            <asp:HyperLink ID="lnkInventory" runat="server"
                                NavigateUrl="~/Users/Staff/Inventory/bookInventory.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-book"></i><span>Book Inventory</span>
                            </asp:HyperLink>
                            <asp:HyperLink ID="lnkLibrarySettings" runat="server"
                                NavigateUrl="~/Users/Admin/Settings/LibrarySettings.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-gear"></i><span>Library Settings</span>
                            </asp:HyperLink>
                            <asp:HyperLink ID="lnkBookImports" runat="server"
                                NavigateUrl="~/Users/Staff/Import/bookImport.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-file-import"></i><span>Book Imports</span>
                            </asp:HyperLink>
                        </div>
                    </div>

                    <div id="subGroupUsers" runat="server" class="nav-submenu">
                        <button type="button" class="nav-submenu-toggle" aria-expanded="false">
                            <i class="fa-solid fa-users"></i>
                            <span>Users</span>
                            <i class="fa-solid fa-chevron-down nav-submenu-chevron"></i>
                        </button>
                        <div class="nav-submenu-list">
                            <asp:HyperLink ID="lnkAccounts" runat="server"
                                NavigateUrl="~/Users/Staff/Accounts/UserAcc.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-tags"></i><span>Accounts</span>
                            </asp:HyperLink>
                            <asp:HyperLink ID="lnkUserImports" runat="server"
                                NavigateUrl="~/Users/Staff/Import/UserImports.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-file-import"></i><span>User Imports</span>
                            </asp:HyperLink>
                            <asp:HyperLink ID="lnkProfile" runat="server"
                                NavigateUrl="~/Users/Patron/Profile/Profile.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-person"></i><span>Profile</span>
                            </asp:HyperLink>
                        </div>
                    </div>

                    <div id="subGroupTransactions" runat="server" class="nav-submenu">
                        <button type="button" class="nav-submenu-toggle" aria-expanded="false">
                            <i class="fa-solid fa-right-left"></i>
                            <span>Transactions</span>
                            <i class="fa-solid fa-chevron-down nav-submenu-chevron"></i>
                        </button>
                        <div class="nav-submenu-list">
                            <asp:HyperLink ID="lnkTransactionImports" runat="server"
                                NavigateUrl="~/Users/Staff/Import/TransactionImport.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-file-import"></i><span>Transaction Imports</span>
                            </asp:HyperLink>
                        </div>
                    </div>

                    <div id="subGroupNotifications" runat="server" class="nav-submenu">
                        <button type="button" class="nav-submenu-toggle" aria-expanded="false">
                            <i class="fa-solid fa-bell"></i>
                            <span>Notifications</span>
                            <i class="fa-solid fa-chevron-down nav-submenu-chevron"></i>
                        </button>
                        <div class="nav-submenu-list">
                            <asp:HyperLink ID="lnkNotifications" runat="server"
                                NavigateUrl="~/Users/Patron/Notifications/Notifications.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-bell"></i><span>Notifications</span>
                            </asp:HyperLink>
                        </div>
                    </div>

                    <!-- ============ SYSTEM REGISTRY ============ -->
                    <div id="navGroupRegistry" runat="server" class="menu-category-label">System Registry</div>

                    <div id="subGroupFeedback" runat="server" class="nav-submenu">
                        <button type="button" class="nav-submenu-toggle" aria-expanded="false">
                            <i class="fa-solid fa-comment-dots"></i>
                            <span>Feedback</span>
                            <i class="fa-solid fa-chevron-down nav-submenu-chevron"></i>
                        </button>
                        <div class="nav-submenu-list">
                            <asp:HyperLink ID="lnkFeedbackRequest" runat="server"
                                NavigateUrl="~/Users/Staff/FeedbackReq/FeedbackRequest.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-comment-dots"></i><span>Feedback Requests</span>
                            </asp:HyperLink>
                            <asp:HyperLink ID="lnkFeedback" runat="server"
                                NavigateUrl="~/Users/Patron/FeedReq/Feedback.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-comment-dots"></i><span>Feedback</span>
                            </asp:HyperLink>
                        </div>
                    </div>

                    <div id="subGroupReports" runat="server" class="nav-submenu">
                        <button type="button" class="nav-submenu-toggle" aria-expanded="false">
                            <i class="fa-solid fa-file-lines"></i>
                            <span>Reports</span>
                            <i class="fa-solid fa-chevron-down nav-submenu-chevron"></i>
                        </button>
                        <div class="nav-submenu-list">
                            <asp:HyperLink ID="lnkReports" runat="server"
                                NavigateUrl="~/Users/Admin/Reports/adminReports.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-users-gear"></i><span>Reports</span>
                            </asp:HyperLink>
                            <asp:HyperLink ID="lnkGenerateReports" runat="server"
                                NavigateUrl="~/Users/Admin/Reports/generateReports.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-users-gear"></i><span>Generate Reports</span>
                            </asp:HyperLink>
                        </div>
                    </div>

                    <div id="subGroupSystem" runat="server" class="nav-submenu">
                        <button type="button" class="nav-submenu-toggle" aria-expanded="false">
                            <i class="fa-solid fa-sliders"></i>
                            <span>System</span>
                            <i class="fa-solid fa-chevron-down nav-submenu-chevron"></i>
                        </button>
                        <div class="nav-submenu-list">
                            <asp:HyperLink ID="lnkSystemLogs" runat="server"
                                NavigateUrl="~/Users/Admin/Logs/SystemLogs.aspx" CssClass="nav-menu-item">
                                <i class="fa-solid fa-sliders"></i><span>System Logs</span>
                            </asp:HyperLink>
                        </div>
                    </div>

                </div>

                <div class="sidebar-user-footer">
                    <%= RenderAvatar("footer") %>

                    <div class="user-meta-info">
                        <p class="user-name"><%= HttpUtility.HtmlEncode(spmst_lms_development.sessionHelper.FullName) %></p>
                        <p class="user-email"><%= HttpUtility.HtmlEncode(spmst_lms_development.sessionHelper.Email) %></p>
                        <p class="user-role"><%= HttpUtility.HtmlEncode(spmst_lms_development.sessionHelper.GetRoleDisplayName()) %></p>
                    </div>

                    <button type="button" class="btn-sidebar-logout" onclick="triggerClientLogout()"
                        title="Terminate Current Session">
                        <i class="fa-solid fa-power-off"></i>
                    </button>
                </div>

            </nav>

            <!-- ============================= MAIN WORKSPACE ============================= -->
            <main class="main-workspace-canvas">

                <header class="desktop-header">
                    <div>
                        <div class="desktop-role-badge">
                            <i class="fa-solid fa-building-user"></i>
                            <span><%= HttpUtility.HtmlEncode(spmst_lms_development.sessionHelper.GetRoleDisplayName()) %></span>
                        </div>
                    </div>

                    <div class="header-action-group">
                        <div class="header-datetime-block">
                            <div class="header-date-string" id="headerCurrentDate">-- -- ----</div>
                            <div class="header-semester-string" id="headerAcademicTerm">Loading Term...</div>
                        </div>

                        <div class="dropdown">
                            <button type="button" class="btn-notification-bell" data-bs-toggle="dropdown" aria-expanded="false"
                                title="System Alerts & Notifications">
                                <i class="fa-regular fa-bell"></i>
                                <% if (dbNotifications != null && dbNotifications.Count > 0) { %>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger notification-count-badge">
                                    <%= dbNotifications.Count %>
                                </span>
                                <% } %>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 p-0 notification-dropdown-menu">
                                <li class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark">Notifications</span>
                                    <span class="badge bg-secondary-subtle text-secondary"><%= dbNotifications?.Count ?? 0 %> New</span>
                                </li>
                                <% 
                                    if (dbNotifications != null && dbNotifications.Count > 0)
                                    {
                                        foreach (var item in dbNotifications)
                                        {
                                %>
                                <li>
                                    <a class="dropdown-item p-3 border-bottom d-flex flex-column gap-1 notification-item-link"
                                       href='<%= ResolveUrl("~/Users/Patron/Notifications/Notifications.aspx") %>'>
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <strong class="text-dark"><%= HttpUtility.HtmlEncode(item.Title) %></strong>
                                            <small class="text-muted text-nowrap notification-timestamp"><%= item.CreatedAt.ToString("g") %></small>
                                        </div>
                                        <p class="text-muted m-0 small text-wrap text-break">
                                            <%= HttpUtility.HtmlEncode(item.Message) %>
                                        </p>
                                    </a>
                                </li>
                                <% 
                                        }
                                    }
                                    else
                                    {
                                %>
                                <li class="p-4 text-center text-muted">
                                    <i class="fa-solid fa-bell-slash fs-4 d-block mb-2 text-opacity-25"></i>
                                    No unread system notifications
                                </li>
                                <% } %>
                            </ul>
                        </div>

                        <%= RenderAvatar("header") %>

                        <button type="button" class="btn-header-logout" onclick="triggerClientLogout()" title="Terminate Workplace Session Framework Connection">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </button>
                    </div>
                </header>

                <div class="workspace-scrollable-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </div>
            </main>

        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function toggleSidebarDrawer() {
            const sidebar = document.getElementById('lmsSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            if (sidebar && backdrop) {
                sidebar.classList.toggle('drawer-open');
                backdrop.classList.toggle('show-backdrop');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {

            // ---------- Submenu toggles (accordion — only one open at a time) ----------
            document.querySelectorAll('.nav-submenu-toggle').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const parent = this.parentElement;
                    const willOpen = !parent.classList.contains('open');

                    // Close every other submenu first.
                    document.querySelectorAll('.nav-submenu.open').forEach(function(other) {
                        if (other !== parent) {
                            other.classList.remove('open');
                            const otherToggle = other.querySelector('.nav-submenu-toggle');
                            if (otherToggle) otherToggle.setAttribute('aria-expanded', 'false');
                        }
                    });

                    // Toggle the clicked one.
                    parent.classList.toggle('open', willOpen);
                    this.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
                });
            });

            // ---------- Active-link detection + auto-open parent submenu ----------
            const currentPath = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll('.nav-menu-item');

            navLinks.forEach(function (link) {
                const href = link.getAttribute('href');
                if (!href) return;
                const linkHref = href.toLowerCase();
                if (linkHref !== '' && currentPath.indexOf(linkHref) !== -1) {
                    navLinks.forEach(function (item) { item.classList.remove('active'); });
                    link.classList.add('active');

                    const parentSub = link.closest('.nav-submenu');
                    if (parentSub) {
                        // Close every other submenu before opening the active one.
                        document.querySelectorAll('.nav-submenu.open').forEach(function(other) {
                            if (other !== parentSub) {
                                other.classList.remove('open');
                                const otherToggle = other.querySelector('.nav-submenu-toggle');
                                if (otherToggle) otherToggle.setAttribute('aria-expanded', 'false');
                            }
                        });

                        parentSub.classList.add('open');
                        const toggle = parentSub.querySelector('.nav-submenu-toggle');
                        if (toggle) toggle.setAttribute('aria-expanded', 'true');
                    }
                }
            });

            // ---------- Date / Term strings ----------
            const dateOptions = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
            const formattedDateString = new Date().toLocaleDateString('en-US', dateOptions);

            const desktopDate = document.getElementById('headerCurrentDate');
            if (desktopDate) desktopDate.textContent = formattedDateString;

            const mobileDate = document.getElementById('mobileCurrentDate');
            if (mobileDate) mobileDate.textContent = formattedDateString;

            const currentMonth = new Date().getMonth();
            let semesterString = "1st Semester";
            if (currentMonth <= 5 && currentMonth >= 4) semesterString = "2nd Semester";
            else if (currentMonth >= 9 || currentMonth <= 3) semesterString = "1st Semester";
            else if (currentMonth >= 6 && currentMonth <= 8) semesterString = "Summer Term";

            const desktopTerm = document.getElementById('headerAcademicTerm');
            if (desktopTerm) desktopTerm.textContent = semesterString;

            const mobileTermReal = document.getElementById('mobileAcademicTerm');
            if (mobileTermReal) mobileTermReal.textContent = semesterString;

            // ---------- Notification bell: initial ring state from server-rendered badge ----------
            document.querySelectorAll('.btn-notification-bell, .mobile-bell-btn').forEach(function (btn) {
                if (btn.querySelector('.notification-count-badge')) {
                    btn.classList.add('bell-ringing');
                }
            });

            // ---------- Notification polling (AJAX, no reload) ----------
            const POLL_INTERVAL_MS = 20000; // 20s
            const pollEndpoint = '<%= ResolveUrl("~/Users/MasterPage/NotificationPoll.ashx") %>';

            function applyBellState(count) {
                document.querySelectorAll('.btn-notification-bell, .mobile-bell-btn').forEach(function (btn) {
                    let badge = btn.querySelector('.notification-count-badge');

                    if (count > 0) {
                        btn.classList.add('bell-ringing');
                        if (!badge) {
                            badge = document.createElement('span');
                            badge.className = 'position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger notification-count-badge';
                            btn.appendChild(badge);
                        }
                        badge.textContent = count;
                    } else {
                        btn.classList.remove('bell-ringing');
                        if (badge && badge.parentNode === btn) btn.removeChild(badge);
                    }
                });
            }

            function pollNotifications() {
                fetch(pollEndpoint, { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) { if (data) applyBellState(data.count || 0); })
                    .catch(function () { /* silent — offline or session expired */ });
            }

            setInterval(pollNotifications, POLL_INTERVAL_MS);
        });

        function triggerClientLogout() {
            window.location.href = '<%= ResolveUrl("~/Login/login.aspx") %>';
        }
    </script>
</body>
</html>