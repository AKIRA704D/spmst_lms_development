<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="LandingPage.master.cs" Inherits="spmst_lms_development.LandingPage.LandingPageMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="SPAMAST Library Management System with Analytics (LMSA) — Malita, Davao Occidental" />
    <meta name="theme-color" content="#0b3d2c" />
    <title>SPAMAST Library | LMSA</title>

    <link rel="icon" type="image/x-icon" href="<%= ResolveUrl("~/favicon.ico") %>" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <!-- FIXED: Corrected path to spamast-theme.css -->
    <link href="<%= ResolveUrl("~/Assets/Themes/spamast-theme.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Assets/Themes/LandingPage.css") %>" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body class="lmsa-body">
    <form id="form1" runat="server" class="lmsa-form">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true"></asp:ScriptManager>

        <div class="lmsa-sticky-shell">
            <div class="lmsa-utility-bar">
                <div class="lmsa-wrap lmsa-utility-inner">
                    <div class="lmsa-utility-left">
                        <a href="tel:+63822723725" class="lmsa-utility-link">
                            <i class="fa-solid fa-phone"></i><span>(082) 272-3725</span>
                        </a>
                        <a href="mailto:library@spamast.edu.ph" class="lmsa-utility-link">
                            <i class="fa-solid fa-envelope"></i><span>library@spamast.edu.ph</span>
                        </a>
                        <span class="lmsa-utility-link lmsa-utility-static">
                            <i class="fa-solid fa-location-dot"></i><span>Malita, Davao Occidental</span>
                        </span>
                    </div>
                    <div class="lmsa-utility-right">
                        <a href="https://www2.spamast.edu.ph" target="_blank" rel="noopener" class="lmsa-utility-link">
                            <i class="fa-solid fa-globe"></i><span>SPAMAST Official Site</span>
                        </a>
                    </div>
                </div>
            </div>

            <header class="lmsa-header">
                <div class="lmsa-wrap lmsa-header-inner">
                    <a href="<%= ResolveUrl("~/LandingPage/Home.aspx") %>" class="lmsa-brand" aria-label="SPAMAST Library Home">
                        <span class="lmsa-logo-group" aria-hidden="true">
                            <img src="<%= SchoolLogoUrl %>" alt="SPAMAST logo" class="lmsa-logo lmsa-logo-school" />
                            <img src="<%= LibraryLogoUrl %>" alt="LMSA library logo" class="lmsa-logo lmsa-logo-library" />
                        </span>
                        <span class="lmsa-brand-text">
                            <span class="lmsa-brand-name">SPAMAST <em>Library</em></span>
                            <span class="lmsa-brand-sub">LMSA &nbsp;|&nbsp; Malita, Davao Occidental</span>
                        </span>
                    </a>

                    <nav class="lmsa-nav-desktop" aria-label="Primary navigation">
                        <ul class="lmsa-nav-list">
                            <li><a href="<%= ResolveUrl("~/LandingPage/Home.aspx") %>" class="lmsa-nav-link <%= NavClass("Home") %>">Home</a></li>
                            <li><a href="<%= ResolveUrl("~/LandingPage/Services.aspx") %>" class="lmsa-nav-link <%= NavClass("Services") %>">Services</a></li>
                            <li><a href="<%= ResolveUrl("~/LandingPage/AboutContact.aspx") %>" class="lmsa-nav-link <%= NavClass("AboutContact") %>">About &amp; Contact</a></li>
                        </ul>
                        <a href="<%= ResolveUrl("~/Login/Login.aspx") %>" class="btn-lmsa-login">
                            <i class="fa-solid fa-right-to-bracket"></i> Login
                        </a>
                    </nav>

                    <button type="button" class="lmsa-burger" data-bs-toggle="offcanvas" data-bs-target="#lmsaMobileNav" aria-controls="lmsaMobileNav" aria-label="Open navigation menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </header>
        </div>

        <div class="offcanvas offcanvas-end lmsa-offcanvas" tabindex="-1" id="lmsaMobileNav" aria-labelledby="lmsaMobileNavLabel">
            <div class="offcanvas-header lmsa-offcanvas-header">
                <div class="lmsa-offcanvas-brand">
                    <img src="<%= LibraryLogoUrl %>" alt="LMSA logo" class="lmsa-offcanvas-logo" />
                    <h5 class="offcanvas-title lmsa-offcanvas-title" id="lmsaMobileNavLabel">Menu</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
            </div>
            <div class="offcanvas-body lmsa-offcanvas-body">
                <nav class="lmsa-mobile-nav" aria-label="Mobile navigation">
                    <a href="<%= ResolveUrl("~/LandingPage/Home.aspx") %>" class="lmsa-mobile-link <%= NavClass("Home") %>">
                        <i class="fa-solid fa-house"></i><span>Home</span>
                    </a>
                    <a href="<%= ResolveUrl("~/LandingPage/Services.aspx") %>" class="lmsa-mobile-link <%= NavClass("Services") %>">
                        <i class="fa-solid fa-list"></i><span>Services</span>
                    </a>
                    <a href="<%= ResolveUrl("~/LandingPage/AboutContact.aspx") %>" class="lmsa-mobile-link <%= NavClass("AboutContact") %>">
                        <i class="fa-solid fa-circle-info"></i><span>About &amp; Contact</span>
                    </a>
                </nav>
                <div class="lmsa-offcanvas-actions">
                    <a href="<%= ResolveUrl("~/Login/Login.aspx") %>" class="btn-lmsa-login-mobile">
                        <i class="fa-solid fa-right-to-bracket"></i> Login
                    </a>
                </div>
                <div class="lmsa-offcanvas-footer">
                    <a href="tel:+63822723725"><i class="fa-solid fa-phone"></i> (082) 272-3725</a>
                    <a href="mailto:library@spamast.edu.ph"><i class="fa-solid fa-envelope"></i> library@spamast.edu.ph</a>
                </div>
            </div>
        </div>

        <main class="lmsa-main" role="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="lmsa-footer">
            <div class="lmsa-wrap lmsa-footer-top">
                <div class="lmsa-footer-col lmsa-footer-col-brand">
                    <div class="lmsa-footer-brand">
                        <img src="<%= SchoolLogoUrl %>" alt="SPAMAST logo" class="lmsa-footer-logo" />
                        <div>
                            <div class="lmsa-footer-brand-name">SPAMAST Library</div>
                            <div class="lmsa-footer-brand-sub">LMSA | Malita, Davao Occidental</div>
                        </div>
                    </div>
                    <p class="lmsa-footer-desc">
                        The SPAMAST Library Management System with Analytics (LMSA) modernizes how the community
                        discovers and borrows materials - from real-time catalog search to transparent,
                        data-driven insight into what the SPAMAST community is reading.
                    </p>
                    <div class="lmsa-footer-social">
                        <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>

                <div class="lmsa-footer-col">
                    <h4 class="lmsa-footer-heading">Explore</h4>
                    <ul class="lmsa-footer-links">
                        <li><a href="<%= ResolveUrl("~/LandingPage/Home.aspx") %>">Home</a></li>
                        <li><a href="<%= ResolveUrl("~/LandingPage/Services.aspx") %>">Services</a></li>
                        <li><a href="<%= ResolveUrl("~/LandingPage/AboutContact.aspx") %>">About &amp; Contact</a></li>
                        <li><a href="<%= ResolveUrl("~/LandingPage/Terms.aspx") %>">Library Terms</a></li>
                        <li><a href="<%= ResolveUrl("~/Login/Login.aspx") %>">Login</a></li>
                    </ul>
                </div>

                <div class="lmsa-footer-col">
                    <h4 class="lmsa-footer-heading">Library Hours</h4>
                    <ul class="lmsa-footer-hours">
                        <li><span>Mon - Fri</span><strong>8:00 AM - 5:00 PM</strong></li>
                        <li><span>Saturday</span><strong>8:00 AM - 12:00 PM</strong></li>
                        <li><span>Sunday &amp; Holidays</span><strong>Closed</strong></li>
                    </ul>
                </div>

                <div class="lmsa-footer-col">
                    <h4 class="lmsa-footer-heading">Contact</h4>
                    <ul class="lmsa-footer-contact">
                        <li><i class="fa-solid fa-location-dot"></i> Poblacion, Malita, Davao Occidental, Philippines 8012</li>
                        <li><i class="fa-solid fa-phone"></i> (082) 272-3725</li>
                        <li><i class="fa-solid fa-envelope"></i> library@spamast.edu.ph</li>
                    </ul>
                </div>
            </div>

            <div class="lmsa-footer-bottom">
                <div class="lmsa-wrap lmsa-footer-bottom-inner">
                    <span>&copy; <span id="lmsa-year">2025</span> Southern Philippines Agri-Business and Marine and Aquatic School of Technology. All rights reserved.</span>
                    <span class="lmsa-footer-bottom-links">
                        <a href="<%= ResolveUrl("~/LandingPage/Terms.aspx") %>">Terms &amp; Privacy</a>
                    </span>
                </div>
            </div>
        </footer>

        <button type="button" class="lmsa-back-to-top" id="lmsaBackToTop" aria-label="Back to top">
            <i class="fa-solid fa-arrow-up"></i>
        </button>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        window.LMSA_ROOT = '<%= ResolveUrl("~/") %>';
        window.LMSA_COVER_FALLBACK = '<%= ResolveUrl("~/Assets/Covers/default-cover.jpg") %>';
        window.LMSA_PROFILE_FALLBACK = '<%= ResolveUrl("~/Assets/Profile/default-cover.png") %>';

        // Backward compatibility for Home.aspx which uses `appRoot` in onerror handlers
        var appRoot = window.LMSA_ROOT;

        // FIXED: Added `return` so Home.aspx can call .then() on this function
        function lmsaApi(action, params, callback) {
            var url = window.LMSA_ROOT + 'LandingPage/LandingData.ashx?action=' + encodeURIComponent(action);
            if (params) {
                for (var k in params) {
                    if (Object.prototype.hasOwnProperty.call(params, k) && params[k] != null) {
                        url += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
                    }
                }
            }
            return fetch(url, { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (data) { if (callback) callback(data); return data; })
                .catch(function (err) { if (callback) callback({ success: false, message: err.message }); return { success: false, message: err.message }; });
        }

        function assetUrl(path) {
            if (!path) return window.LMSA_COVER_FALLBACK;
            if (/^https?:\/\//i.test(path)) return path;
            if (path.charAt(0) === '/') return path;
            return window.LMSA_ROOT + path.replace(/^~\//, '').replace(/^\/+/, '');
        }

        function lmsaEscape(str) {
            if (str == null) return '';
            return String(str).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        (function () {
            var y = document.getElementById('lmsa-year');
            if (y) y.textContent = new Date().getFullYear();

            var back = document.getElementById('lmsaBackToTop');
            if (back) {
                window.addEventListener('scroll', function () {
                    if (window.pageYOffset > 400) back.classList.add('is-visible');
                    else back.classList.remove('is-visible');
                }, { passive: true });
                back.addEventListener('click', function () {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }

            document.addEventListener('error', function (e) {
                var img = e.target;
                if (!img || img.tagName !== 'IMG') return;
                if (img.dataset.lmsaFallback === '1') return;
                img.dataset.lmsaFallback = '1';
                if (/\/Assets\/Covers\//.test(img.src)) {
                    img.src = window.LMSA_COVER_FALLBACK;
                } else if (/\/Assets\/Profile\//.test(img.src)) {
                    img.src = window.LMSA_PROFILE_FALLBACK;
                }
            }, true);
        })();
    </script>

    <asp:ContentPlaceHolder ID="scripts" runat="server" />
</body>
</html>